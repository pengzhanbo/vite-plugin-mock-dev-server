{
  "compilerOptions": {
    "target": "ESNext",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@mock-shared": ["./mock/shared"],
      "@mock-shared/*": ["./mock/shared/*"]
    }
  },
  "include": [
    "./env.d.ts",
    "./src",
    "./mock",
    "./vite.config.ts",
    "./plugin-options.ts",
    "./plugins"
  ],
  "exclude": ["./**/*.mjs", "./**/*.cjs", "./**/*.js"]
}
